# ---- DPGLF platform environment ---------------------------------------------
# Copy to .env.local and fill in. Never commit .env.local.

# Public site identity
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="Dr. Phillip Gwatidzo Literary Foundation"

# ---- Database ----------------------------------------------------------------
# Neon Postgres. Use the POOLED connection string for the app.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ---- Sessions ----------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The app refuses to boot in production without this.
AUTH_SECRET=
ACCESS_TTL=900
REFRESH_TTL=2592000

# ---- Cloudflare R2 (bucket: aurorasystems, prefix: dpglf/) --------------------
# Private bucket. Brand media is served through /media/*; manuscripts only ever
# leave through a short-lived signed URL after a permission check.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ACCESS_key_id=
CLOUDFLARE_SECRET_ACCESS_KEY=
CLOUDFLARE_BUCKET_NAME=aurorasystems
# Optional: set once a CDN hostname is bound to the bucket, e.g.
# https://cdn.dpglf.org — leave empty to keep serving through /media/*.
CLOUDFLARE_PUBLIC_URL=

# ---- Email (Resend) ------------------------------------------------------------
# Without a key, email is skipped and logged — the app still works, and every
# intended message is recorded in the notifications table.
RESEND_API_KEY=
EMAIL_FROM="DPGLF <noreply@updates.gwatidzo.me>"
# Staff mailbox: alerts for new submissions, contact messages, rights enquiries
# and completed reviews. Also shown publicly on /contact.
FOUNDATION_INBOX=hello@dpglf.org

# ---- Scheduled maintenance -------------------------------------------------------
# Protects /api/cron (deadline reminders, Emoworld drain, housekeeping).
CRON_KEY=

# ---- Emoworld publishing handoff --------------------------------------------------
# Approved stories always queue. They are only SENT when this is fully set.
# Sent as POST {EMOWORLD_API_BASE}/api/partners/dpglf/stories with
# "Authorization: Bearer {EMOWORLD_SYNC_SECRET}". Emoworld holds the same value
# as its DPGLF_SYNC_KEY Worker secret. Generate: openssl rand -hex 32
EMOWORLD_SYNC_ENABLED=false
EMOWORLD_API_BASE=https://emoworld.co.zw
EMOWORLD_SYNC_SECRET=
